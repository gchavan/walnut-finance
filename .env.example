# SimpleFIN is the live bank source. Do not paste a setup token here —
# paste it in the Walnut UI (Settings → App, or the setup banner).
# After a successful claim the app writes SIMPLEFIN_ACCESS_URL into
# gitignored .env (mode 0600). Never commit .env.

SIMPLEFIN_ACCESS_URL=

# Loopback only. This app has no authentication.
WALNUT_WEB_HOST=127.0.0.1
WALNUT_WEB_PORT=8766

# SQLite lives here (mode 0600). Directory is gitignored.
# WALNUT_DATA_DIR=./data
